rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Block all unauthenticated and direct client reads and writes.
    // Files are accessible only via the Firebase Admin SDK (Cloud Functions)
    // and the server-to-server authenticated Julia backend Service Account.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}