rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Block all direct client-side and unauthenticated REST API reads and writes.
    // Access is only permitted via the Firebase Admin SDK (Cloud Functions)
    // and the authenticated Julia backend Service Account.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}